# ── 大模型 API 敏感密钥 ──
OPENAI_API_KEY=your_openai_api_key_here

# ── 飞书开放平台敏感凭据 ──
LARK_APP_ID=your_lark_app_id_here
LARK_APP_SECRET=your_lark_app_secret_here

# ── WPS 开放平台敏感凭据 ──
WPS_APP_ID=your_wps_app_id_here
WPS_APP_SECRET=your_wps_app_secret_here

# ─────────────────────────────────────────────────────────
# 部门预设敏感凭据覆盖 (可选。留空时自动继承上方通用凭据)
# ─────────────────────────────────────────────────────────
# HSE_OPENAI_API_KEY=your_hse_openai_key
# HSE_LARK_APP_SECRET=your_hse_lark_app_secret
# HSE_WPS_APP_ID=your_hse_wps_app_id
# HSE_WPS_APP_SECRET=your_hse_wps_app_secret
